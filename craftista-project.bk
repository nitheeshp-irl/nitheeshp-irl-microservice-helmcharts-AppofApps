apiVersion: argoproj.io/v1alpha1
kind: AppProject
metadata:
  name: craftista
  namespace: argocd
spec:
  description: Craftista microservices project
  sourceRepos:
    - 'https://github.com/nitheeshp-irl/nitheeshp-irl-microservice-helmcharts-AppofApps'
  destinations:
    - namespace: 'argocd'
      server: 'https://kubernetes.default.svc'
    - namespace: 'frontend'
      server: 'https://kubernetes.default.svc
  clusterResourceWhitelist:
    - group: '*'
      kind: '*'